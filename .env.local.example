# Copy to .env.local and fill in. The dev server reads .env.local automatically.

# Supabase — get these from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only key (used for trusted server actions like seeding). Never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3004
